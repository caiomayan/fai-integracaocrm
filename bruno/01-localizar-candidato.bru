meta {
  name: 01 Localizar candidato
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/local/faicrm/rest_json.php/core_user_get_users_by_field
  body: json
  auth: inherit
}

body:json {
  {
    "field": "username",
    "values": [
      "12345678900"
    ]
  }
}

docs {
  Localiza a Maria da Silva pelo username (CPF).
  Resposta esperada: 200 com uma lista com a Maria (id 72). Lista vazia `[]` se o username não existir.
}
