meta {
  name: 02b Matricular com papel não permitido
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/local/faicrm/rest_json.php?wsfunction=enrol_manual_enrol_users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "enrolments": [
      {
        "roleid": 3,
        "userid": {{userid}},
        "courseid": {{courseid}}
      }
    ]
  }
}

assert {
  res.status: eq 403
}

tests {
  test("papel diferente de Estudante é recusado com 403 e mensagem em português", function () {
    expect(res.status).to.equal(403);
    expect(res.body.message).to.equal("Não é permitido matricular com este papel.");
  });
}

docs {
  Roda **antes** do 03, com o candidato ainda sem matrícula (quem já está matriculado recebe 409, e a checagem de matrícula vem antes da checagem de papel). Tenta matricular com `roleid` 3 (professor). O usuário técnico só pode atribuir o papel Estudante, então a resposta é HTTP 403 com `{"message":"Não é permitido matricular com este papel."}` e a matrícula não é feita.
}
