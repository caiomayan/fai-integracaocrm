meta {
  name: 03 Matricular candidato
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/local/faicrm/rest_json.php?wsfunction=enrol_manual_enrol_users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "enrolments": [
      {
        "userid": {{userid}},
        "courseid": {{courseid}}
      }
    ]
  }
}

tests {
  test("matrícula devolve 204 sem corpo", function () {
    expect(res.status).to.equal(204);
    expect(res.body === "" || res.body === null || res.body === undefined).to.equal(true);
  });
}

docs {
  Matricula o candidato no curso com `enrol_manual_enrol_users`, **sem `roleid`**: o adaptador usa o papel `student` (procurado pelo shortname, não fixo em 5). Se o `roleid` for enviado, ele é respeitado (veja o 03b).
  
  Sucesso: HTTP 204, sem corpo. O candidato passa a aparecer em Participantes como Estudante.
}
