meta {
  name: 03b Matricular com roleid
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/local/faicrm/rest_json.php?wsfunction=enrol_manual_enrol_users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "enrolments": [
      {
        "roleid": {{roleid}},
        "userid": {{userid}},
        "courseid": {{courseid}}
      }
    ]
  }
}

tests {
  test("matrícula devolve 204 sem corpo", function () {
    expect(res.status).to.equal(204);
    expect(res.body === "" || res.body === null || res.body === undefined).to.equal(true);
  });
}

docs {
  Igual ao 03, mas envia `roleid` explicitamente (`{{roleid}}`, 5 = Estudante). O papel enviado é respeitado; o `ws_crm` só pode atribuir Estudante (outro papel devolve `wsusercannotassign`).

  Sucesso: HTTP 204, sem corpo.
}
