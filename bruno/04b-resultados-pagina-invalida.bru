meta {
  name: 04b Resultados com página inválida
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/local/faicrm/rest_json.php?wsfunction=local_faicrm_get_resultados_vestibular
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "courseid": {{courseid}},
    "pagina": 0
  }
}

assert {
  res.status: eq 400
}

tests {
  test("pagina menor que 1 devolve 400 com mensagem em português", function () {
    expect(res.status).to.equal(400);
    expect(res.body.message).to.equal("Dados inválidos: pagina deve ser maior ou igual a 1.");
  });
}

docs {
  `pagina` só aceita valores maiores ou iguais a 1. Com `pagina` 0 a resposta é HTTP 400 com
  `{"message":"Dados inválidos: pagina deve ser maior ou igual a 1."}`.
}
