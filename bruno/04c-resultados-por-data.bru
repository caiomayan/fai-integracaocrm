meta {
  name: 04c Resultados: provas de hoje
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/local/faicrm/rest_json.php?wsfunction=local_faicrm_get_resultados_vestibular
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "courseid": {{courseid}},
    "dataprovade": "{{dataprovade}}",
    "dataprovaate": "{{dataprovaate}}"
  }
}

script:pre-request {
  // "Hoje" em America/Sao_Paulo (UTC-3, sem horário de verão): AAAA-MM-DD.
  var hoje = new Date(Date.now() - 3 * 60 * 60 * 1000).toISOString().slice(0, 10);
  bru.setVar("dataprovade", hoje);
  bru.setVar("dataprovaate", hoje);
}

tests {
  test("status 200 e objeto paginado", function () {
    expect(res.status).to.equal(200);
    ["total", "pagina", "porpagina", "totalpaginas", "candidatos"].forEach(function (k) {
      expect(res.body).to.have.property(k);
    });
  });
  test("só candidatos com prova dentro do intervalo", function () {
    var de = new Date(bru.getVar("dataprovade") + "T00:00:00-03:00").getTime();
    var ate = new Date(bru.getVar("dataprovaate") + "T23:59:59-03:00").getTime();
    res.body.candidatos.forEach(function (c) {
      expect(c.dataprova).to.not.equal(null);
      var t = new Date(c.dataprova).getTime();
      expect(t).to.be.at.least(de);
      expect(t).to.be.at.most(ate);
    });
  });
}

docs {
  Lista quem fez a prova **hoje** (fuso America/Sao_Paulo). O script pré-requisição calcula a data de hoje e usa o mesmo dia em `dataprovade` e `dataprovaate`: nada para digitar.

  **Para aparecer alguém, é preciso que tenha havido uma prova hoje.** Antes de rodar este item, simule a prova do candidato criado no 02 (use o `username` gerado pelo 01):
  ```
  docker compose exec -u www-data moodle php /opt/fai/simular_prova.php --username=<username> --acertos=4
  ```
  ou faça a prova no navegador. Sem prova hoje, a resposta é `total: 0` (também é um resultado válido).

  - Filtro por **data da prova** (fim da última tentativa finalizada). Formato: só data `AAAA-MM-DD`; `dataprovade` = 00:00:00 do dia e `dataprovaate` = 23:59:59 do dia.
  - Com filtro, candidatos sem prova ficam de fora, e `total`/`totalpaginas` respeitam o filtro.
}
