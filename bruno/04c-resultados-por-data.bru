meta {
  name: 04c Resultados por data da prova
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/local/faicrm/rest_json.php?wsfunction=local_faicrm_get_resultados_vestibular
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "courseid": {{courseid}},
    "dataprovade": "{{dataprovade}}",
    "dataprovaate": "{{dataprovaate}}"
  }
}

tests {
  test("status 200 e objeto paginado", function () {
    expect(res.status).to.equal(200);
    ["total", "pagina", "porpagina", "totalpaginas", "candidatos"].forEach(function (k) {
      expect(res.body).to.have.property(k);
    });
  });
  test("só candidatos com prova dentro do intervalo", function () {
    var de = new Date(bru.getEnvVar("dataprovade") + "T00:00:00-03:00").getTime();
    var ate = new Date(bru.getEnvVar("dataprovaate") + "T23:59:59-03:00").getTime();
    res.body.candidatos.forEach(function (c) {
      expect(c.dataprova).to.not.equal(null);
      var t = new Date(c.dataprova).getTime();
      expect(t).to.be.at.least(de);
      expect(t).to.be.at.most(ate);
    });
  });
}

docs {
  Filtra pela **data da prova** (fim da última tentativa finalizada do questionário). Os dois filtros são opcionais e usam as variáveis `dataprovade` e `dataprovaate` do ambiente (padrão: 2026-01-01 a 2026-12-31).

  - Formato: só data `AAAA-MM-DD`, fuso America/Sao_Paulo. `dataprovade` = 00:00:00 do dia; `dataprovaate` = 23:59:59 do dia.
  - Com filtro, candidatos sem prova ficam de fora, e `total`/`totalpaginas` respeitam o filtro.
  - Dia exato: `dataprovade` = `dataprovaate`.
}
