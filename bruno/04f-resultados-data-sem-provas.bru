meta {
  name: 04f Resultados: data sem provas
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/local/faicrm/rest_json.php?wsfunction=local_faicrm_get_resultados_vestibular
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "courseid": {{courseid}},
    "dataprovade": "{{dataprovade}}",
    "dataprovaate": "{{dataprovaate}}"
  }
}

script:pre-request {
  // Um dia em que não houve prova.
  bru.setVar("dataprovade", "2020-01-01");
  bru.setVar("dataprovaate", "2020-01-01");
}

tests {
  test("sem provas na data: total 0 e lista vazia", function () {
    expect(res.status).to.equal(200);
    expect(res.body.total).to.equal(0);
    expect(res.body.totalpaginas).to.equal(0);
    expect(res.body.candidatos).to.be.an("array").that.is.empty;
  });
}

docs {
  Filtra por um dia sem provas (2020-01-01). A resposta é HTTP 200 com `total: 0`, `totalpaginas: 0` e `candidatos: []`.
}
