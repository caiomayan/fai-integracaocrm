post {
  url: http://localhost:8080/local/faicrm/rest_json.php/local_faicrm_get_resultados_vestibular
  body: json
  auth: inherit
}

body:json {
  {
    "courseid": 2,
    "porpagina": 50
  }
}

docs {
  O tamanho da página é fixo em 100; `porpagina` não é um parâmetro.
  Resposta esperada: 400 "Dados inválidos: porpagina não é aceito; o serviço usa 100 por página."
}
