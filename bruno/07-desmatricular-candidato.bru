meta {
  name: 07 Desmatricular candidato
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/local/faicrm/rest_json.php?wsfunction=enrol_manual_unenrol_users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "enrolments": [
      {
        "userid": {{userid}},
        "courseid": {{courseid}},
        "roleid": {{roleid}}
      }
    ]
  }
}

tests {
  test("desmatrícula devolve 204 sem corpo", function () {
    expect(res.status).to.equal(204);
    expect(res.body === "" || res.body === null || res.body === undefined).to.equal(true);
  });
}

docs {
  Remove a matrícula manual com `enrol_manual_unenrol_users`. Sucesso: HTTP 204, sem corpo.
  Depois disso o candidato deixa de aparecer no 04.
}
