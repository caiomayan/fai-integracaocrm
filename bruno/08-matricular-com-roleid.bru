meta {
  name: 08 Matricular com roleid
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/local/faicrm/rest_json.php?wsfunction=enrol_manual_enrol_users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "enrolments": [
      {
        "roleid": {{roleid}},
        "userid": {{userid}},
        "courseid": {{courseid}}
      }
    ]
  }
}

tests {
  test("matrícula devolve 204 sem corpo", function () {
    expect(res.status).to.equal(204);
    expect(res.body === "" || res.body === null || res.body === undefined).to.equal(true);
  });
}

docs {
  Roda **depois** do 07 (o candidato já foi desmatriculado) e matricula de novo, agora enviando `roleid` explicitamente (`{{roleid}}`, 5 = Estudante). O papel enviado é respeitado. Quem já está matriculado recebe 409 (veja o 03d).

  Sucesso: HTTP 204, sem corpo.
}
