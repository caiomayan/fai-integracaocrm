meta {
  name: 95 Campo obrigatório ausente
  type: http
  seq: 95
}

post {
  url: {{baseUrl}}/local/faicrm/rest_json.php?wsfunction=local_faicrm_get_resultados_vestibular
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {}
}

assert {
  res.status: eq 400
  res.body.message: eq Dados inválidos: o campo curso é obrigatório.
}

tests {
  test("erro só com message, sem detalhes técnicos", function () {
    expect(Object.keys(res.body)).to.eql(["message"]);
  });
}

docs {
  Resultados sem `courseid`. Resposta: HTTP 400 com
  `{"message":"Dados inválidos: o campo curso é obrigatório."}`.
}
