meta {
  name: 99 Token inválido
  type: http
  seq: 99
}

post {
  url: {{baseUrl}}/local/faicrm/rest_json.php?wsfunction=local_faicrm_get_resultados_vestibular
  body: json
  auth: bearer
}

auth:bearer {
  token: invalido
}

body:json {
  {
    "courseid": {{courseid}}
  }
}

assert {
  res.status: eq 401
  res.body.message: eq Token de acesso inválido ou ausente.
}

tests {
  test("erro só com message, sem detalhes técnicos", function () {
    expect(Object.keys(res.body)).to.eql(["message"]);
  });
  test("tem X-Request-Id", function () {
    expect(res.headers["x-request-id"]).to.match(/^[0-9a-f]{16}$/);
  });
}

docs {
  Mesma chamada do 04 com token inválido (header Bearer). Resposta: HTTP 401 com
  `{"message":"Token de acesso inválido ou ausente."}`. Sem o header Authorization a resposta é a mesma.
}
